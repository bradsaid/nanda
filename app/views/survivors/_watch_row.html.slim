li.list-group-item.d-flex.flex-wrap.justify-content-between.align-items-center.gap-2
  = link_to "#{season.series&.name} Season #{season.number}", season_path(season), class: "fw-semibold text-decoration-none"
  .d-flex.flex-wrap.gap-2
    - services.each do |service_key, url|
      = link_to streaming_label(service_key), url, target: "_blank", rel: "noopener", class: "btn btn-primary btn-sm"
