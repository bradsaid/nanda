- content_for :title, "#{@user.username} — Forum profile"

.pb-2.mb-4.border-bottom.site-header
  nav.small.mb-1
    = link_to "Forum", forum_path, class: "text-decoration-none text-muted"
    span.mx-1 &raquo;
    span = @user.username
  .d-flex.align-items-center.gap-3.flex-wrap
    - if @user.avatar.attached?
      = image_tag @user.avatar.variant(resize_to_limit: [96, 96]), class: "rounded-circle border", style: "width:64px;height:64px;object-fit:cover;"
    .d-flex.flex-column
      .d-flex.align-items-center.gap-2
        h1.h3.mb-0.logo = @user.username
        - if @role_badge
          span.badge.text-bg-primary = @role_badge
      - if @user.bio.present?
        p.subtitle.mb-0.mt-1 = @user.bio
  - if logged_in? && (current_user.id == @user.id || admin_signed_in?)
    .mt-2.d-flex.gap-2.flex-wrap
      = link_to "Edit profile", forum_edit_profile_path(username: @user.username), class: "btn btn-outline-secondary btn-sm"
      / Full admins get the same controls the directory offers, here where the
      / decision is actually made. Not shown on your own profile, and not for
      / another admin — both are lockout risks.
      - if current_user.admin? && current_user.id != @user.id && !@user.admin?
        = button_to "Reset password", password_reset_admin_forum_user_path(@user), method: :post,
          class: "btn btn-outline-secondary btn-sm",
          form: { style: "display:inline;", data: { turbo_confirm: "Email #{@user.username} a password reset link?" } }
        - if @user.banned?
          = button_to "Unban", admin_forum_user_path(@user), method: :patch, params: { decision: "unban" },
            class: "btn btn-outline-secondary btn-sm", form: { style: "display:inline;" }
        - else
          = button_to "Ban", admin_forum_user_path(@user), method: :patch, params: { decision: "ban" },
            class: "btn btn-outline-danger btn-sm",
            form: { style: "display:inline;", data: { turbo_confirm: "Ban #{@user.username}? They will be signed out immediately." } }
        = button_to "Delete user", admin_forum_user_path(@user), method: :delete,
          class: "btn btn-danger btn-sm",
          form: { style: "display:inline;", data: { turbo_confirm: "Permanently delete #{@user.username}?\n\nThis also deletes every topic and post they wrote. This cannot be undone." } }

.row.g-3.mb-4
  .col-6.col-md-3
    .card.text-center.shadow-sm
      .card-body.py-3
        div.h4.mb-0 = @posts_count
        small.text-muted Posts
  .col-6.col-md-3
    .card.text-center.shadow-sm
      .card-body.py-3
        div.h4.mb-0 = @topics_count
        small.text-muted Topics started
  .col-12.col-md-6
    .card.text-center.shadow-sm
      .card-body.py-3
        div.h6.mb-0 = @member_since.strftime("%B %-d, %Y")
        small.text-muted Member since

h2.h5.mb-3 Recent posts
- if @recent_posts.any?
  .d-flex.flex-column.gap-2
    - @recent_posts.each do |p|
      .card.shadow-sm
        .card-body.py-2.px-3
          .small.text-muted.d-flex.gap-2.flex-wrap
            = forum_time(p.created_at)
            span in
            = link_to p.forum_topic.title, forum_topic_path(p.forum_topic, anchor: "post-#{p.id}"), class: "text-decoration-none"
          .mt-1.small.forum-post-body(style="max-height: 4.5rem; overflow: hidden;")
            == p.body_html
- else
  p.text-muted No posts yet.
