- content_for :title, "Edit profile — #{@profile_username}"

.pb-2.mb-4.border-bottom.site-header
  nav.small.mb-1
    = link_to "Forum", forum_path, class: "text-decoration-none text-muted"
    span.mx-1 &raquo;
    = link_to @profile_username, forum_profile_path(username: @profile_username), class: "text-decoration-none text-muted"
    span.mx-1 &raquo;
    span Edit
  h1.h3.mb-0.logo Edit your profile

.row.justify-content-center
  .col-md-8
    .card.shadow-sm
      .card-body
        - if @user.errors.any?
          .alert.alert-danger
            ul.mb-0.small
              - @user.errors.full_messages.each do |m|
                li = m

        = form_with model: @user, url: forum_profile_path(username: @profile_username), method: :patch, multipart: true, local: true do |f|
          .mb-3
            = f.label :username, "Username", class: "form-label"
            = f.text_field :username, class: "form-control", minlength: 3, maxlength: 20, autocomplete: "username"
            .form-text
              | 3 to 20 characters. Letters, numbers and underscores only. This is the name on your posts, and your profile address changes with it &mdash; any link you have shared to the old one will stop working.

          .mb-3
            = f.label :avatar, "Profile picture", class: "form-label"
            - if @avatar_preview&.attached?
              .mb-2
                = image_tag @avatar_preview.variant(resize_to_limit: [128, 128]), class: "rounded-circle border"
                .small.text-muted.mt-1 Uploading a new image replaces this one.
            = f.file_field :avatar, accept: "image/*", class: "form-control form-control-sm"
            .form-text Under 5 MB. Square works best. Shown beside your name on every post.

          .mb-3
            = f.label :bio, "About you", class: "form-label"
            = f.text_area :bio, rows: 4, class: "form-control", maxlength: User::BIO_MAX_LEN, placeholder: "A short introduction."
            .form-text = "Up to #{User::BIO_MAX_LEN} characters. Shown at the top of your profile."

          .d-flex.gap-2.pb-1
            = f.submit "Save profile", class: "btn btn-primary"
            = link_to "Cancel", forum_profile_path(username: @profile_username), class: "btn btn-outline-secondary"

- if current_user&.id == @user.id
  .row.justify-content-center.mt-4
    .col-md-8
      .card.shadow-sm
        .card-header Email address
        .card-body
          p.small.text-muted.mb-3
            | Signed in as
            strong<>  = @user.email_address
            |  . Changing this changes how you sign in, so the new address has to be confirmed before it takes effect.

          - if @user.pending_email_address.present?
            .alert.alert-warning.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
              div
                | Waiting for confirmation at
                strong<>  = @user.pending_email_address
                br
                span.small Check that inbox for the link. Your current address stays in use until you do.
              = button_to "Cancel change", forum_cancel_email_change_path(username: @profile_username), method: :delete, class: "btn btn-outline-secondary btn-sm"

          = form_with url: forum_request_email_change_path(username: @profile_username), method: :post, local: true do
            .mb-3
              = label_tag :new_email_address, "New email address", class: "form-label"
              = email_field_tag :new_email_address, nil, class: "form-control", required: true, autocomplete: "email"
            .mb-3
              = label_tag :current_password, "Your current password", class: "form-label"
              = password_field_tag :current_password, nil, class: "form-control", required: true, autocomplete: "current-password"
              .form-text Required so nobody else can move your account.
            = submit_tag "Send confirmation link", class: "btn btn-primary"
