- content_for :title, "Forum — Naked & Afraid Fan Wiki"
- content_for :meta_description, "Fan discussion for Naked and Afraid: episode reactions, survivor threads, item talk, and more."

.pb-2.mb-4.border-bottom.site-header
  .d-flex.align-items-center.justify-content-between.flex-wrap.gap-3
    .d-flex.flex-column
      h1.h3.mb-0.logo Forum
      p.subtitle.mb-0 Talk about episodes, survivors, gear, and everything else.
    .d-flex.align-items-center.gap-2.flex-wrap
      - if forum_read_only?
        span.badge.text-bg-warning Preview mode (hidden from public)
      - if logged_in? && current_user.username.present?
        = link_to "My profile", forum_profile_path(username: current_user.username), class: "btn btn-outline-primary"
      - if logged_in? && current_user.email_verified? && !forum_read_only?
        = link_to "New topic", new_forum_topic_path, class: "btn btn-primary"

.d-flex.align-items-center.gap-2.mb-3.flex-wrap
  = link_to "Members", forum_profiles_path, class: "btn btn-sm btn-outline-secondary"
  span.vr.mx-1
  span.small.text-muted.me-1 Sort:
  - [["recent", "Recent"], ["popular", "Popular"], ["active", "Active"]].each do |key, label|
    = link_to label, forum_path(sort: key),
      class: "btn btn-sm #{@sort == key ? 'btn-dark' : 'btn-outline-secondary'}"
  - if @sort == "popular"
    span.small.text-muted.ms-1 most viewed
  - elsif @sort == "active"
    span.small.text-muted.ms-1 most replies

- if @topics.any?
  .card.shadow-sm
    .table-responsive.table-stack-host
      table.table.table-hover.mb-0
        thead.table-light
          tr
            th Topic
            th Replies
            th Views
            th Last activity
        tbody
          - @topics.each do |t|
            tr.forum-topic-row data-topic-href=forum_topic_path(t)
              td data-label="Topic"
                - if t.pinned?
                  span.badge.text-bg-warning.me-1 pinned
                = link_to t.title, forum_topic_path(t), class: "fw-semibold text-decoration-none"
                .small.text-muted
                  ' by
                  = forum_user_link(t.user)
                  '  · #{forum_time(t.created_at)}
              td data-label="Replies" = [@active_post_counts.fetch(t.id, 0) - 1, 0].max
              td data-label="Views" = t.views_count
              td data-label="Last activity"
                - if t.last_post_at
                  = forum_time(t.last_post_at)
                  - if t.last_post_user
                    .small.text-muted
                      ' by
                      = forum_user_link(t.last_post_user)
                - else
                  span.text-muted —
  = paginate @topics
- else
  .card.shadow-sm.text-center.py-4
    p.mb-2.text-muted No topics yet.
    - if logged_in? && current_user.email_verified?
      = link_to "Start the first thread", new_forum_topic_path, class: "btn btn-primary"
    - elsif logged_in?
      p.small.text-muted.mb-0 Verify your email to post.
    - else
      p.small.text-muted.mb-0
        = link_to "Sign in", new_session_path
        |  or
        = link_to "create an account", signup_path
        |  to post.

- if logged_in?
  p.small.text-muted.mt-3.mb-0
    ' Signed in as
    - if current_user.username.present?
      = link_to current_user.username, forum_profile_path(username: current_user.username)
      '  ·
      = link_to "Edit your profile", forum_edit_profile_path(username: current_user.username)
    - else
      = forum_user_display(current_user)
    - unless current_user.email_verified?
      br
      strong Please verify your email before posting.
