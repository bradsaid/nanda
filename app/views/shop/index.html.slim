- content_for :title, "Shop Naked and Afraid Gear"
- content_for :meta_description, "Gear used on Naked and Afraid, or the closest thing you can buy: machetes, knives, fire starters, pots, fishing and hunting tools, plus official books and merch, with where each product was spotted on the show."
- content_for :canonical_url, shop_url
- if @filtered
  - content_for :robots, "noindex, follow"

- match_badge = ShopCatalog::BADGES

.container.my-4
  = render "shared/flash"

  h1.h3.mb-2 Shop Naked and Afraid Gear
  p.text-muted.small.mb-3(style="max-width: 760px;")
    | Real products used on the show, or the closest thing you can buy, with where each connection was found. "Confirmed" means a credible source such as the maker, the cast member or the producers says it was used; "Similar" is the nearest buyable equivalent.

  = render "shop/disclosure"

  - if (guides = ShopCatalog.guides).any?
    p.small.mb-3
      strong.me-1 Guides:
      - guides.each_with_index do |g, i|
        = " · " if i.positive?
        = link_to g.heading, shop_guide_path(g.slug), class: "text-decoration-none"

  = form_with url: shop_path, method: :get, local: true, class: "card shadow-sm mb-4" do
    .card-header.d-flex.align-items-center.gap-2
      span.me-2(aria-hidden="true") 🔎
      span Filter
    .card-body.pb-3
      .row.g-3
        .col-md-4
          = label_tag :q, "Search", class: "form-label"
          = text_field_tag :q, @q, placeholder: "e.g. machete, Gerber, Eva Rupert", class: "form-control"
        .col-md-3
          = label_tag :category, "Category", class: "form-label"
          = select_tag :category, options_for_select([["All categories", ""]] + @categories.map { |c| [c.titleize, c] }, @category), class: "form-select"
        .col-md-3
          = label_tag :match, "How sure are we", class: "form-label"
          = select_tag :match, options_for_select([["Any", ""]] + match_badge.map { |k, (_, label)| [label, k] }, @match), class: "form-select"
        .col-12.col-md-auto.d-flex.align-items-end.gap-3
          .form-check.mb-2
            = check_box_tag :amazon, "1", @amazon, class: "form-check-input"
            = label_tag :amazon, "On Amazon", class: "form-check-label"
          = submit_tag "Apply", class: "btn btn-dark mb-1"
          = link_to "Reset", shop_path, class: "btn btn-light mb-1"

  p#shop-count.text-muted.mb-4
    = "#{@products.size} of #{@total} products"
    = " · #{@amazon_total} with an Amazon listing"

  - if @grouped.empty?
    .alert.alert-light.border No products match those filters.

  - @grouped.each do |category, products|
    .card.shadow-sm.mb-4
      .card-header
        = category.to_s.titleize
        small.ms-2 = "(#{products.size})"
      ul.list-group.list-group-flush
        - products.each do |p|
          = render "shop/product", product: p, item: @items_by_name[p[:item].to_s.downcase], link_item: true, links: @links
