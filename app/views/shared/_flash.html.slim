/ Flash messages were set all over the app (notice: / alert:) but no layout
/ ever rendered them, so every success and error was silently discarded —
/ which is why a rejected upload looked like it simply did nothing.
- flash.each do |type, message|
  - next if message.blank?
  - css = { "notice" => "alert-success", "alert" => "alert-danger" }.fetch(type.to_s, "alert-info")
  div class="alert #{css} mb-3" role="alert" aria-live="polite"
    = message
