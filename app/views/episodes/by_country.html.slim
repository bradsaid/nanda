/ ===== SEO + JSON-LD: Episodes by Country =====
- country_name = @country.to_s
- ep_list      = (@episodes || [])

- content_for :title, country_episodes_title(country_name, page: @page_number)
- country_alias_names = CountryAliases.for(country_name)
- content_for :meta_description, country_meta_description(country_name, ep_list.size, country_alias_names, @page_number)
- content_for :keywords, "Naked and Afraid episodes, #{country_name}, filming locations, survivors, episode guide"
- content_for :canonical_url, canonical_request_url
- content_for :og_title, "Episodes in #{country_name} – Naked and Afraid"
- content_for :og_description, "Episode list for #{country_name} with dates, locations, and survivors."

/ Server-rendered JSON-LD (CollectionPage + ItemList for the country)
/ The episodes on THIS page of cards (a continuous-story season card holds several).
- page_eps = @blocks.flat_map { |b| b[:kind] == :season ? b[:eps] : [b[:ep]] }
= render_jsonld(episodes_by_country_jsonld(country: country_name, episodes: page_eps, position_offset: ((@page_number || 1) - 1) * EpisodesController::COUNTRY_BLOCKS_PER_PAGE))
/ ===== end SEO + JSON-LD =====

- hero_flag    = country_flag_url(@country, size: 320)
- hero_outline = country_outline_url(@country, width: 480)

.pb-2.mb-3.border-bottom.site-header
  .d-flex.align-items-center.justify-content-between.flex-wrap.gap-3
    .d-flex.align-items-center.gap-3
      - if hero_flag && hero_outline
        .country-shape-wrap
          .country-shape.country-shape-lg(style="background-image: url(#{hero_flag}); --outline-url: url(#{hero_outline});" aria-label="#{@country} flag in country outline")
      - elsif hero_flag
        = image_tag hero_flag, alt: @country, width: 96, loading: "eager", class: "rounded shadow-sm"
      .d-flex.flex-column
        h1.h3.mb-0.logo = "Episodes in #{@country}"
        p.subtitle.mb-0 = "All Episodes in #{@country}"
        / Misspellings / alternate names people search for ("Columbia"); config/country_aliases.yml.
        - if country_alias_names.any?
          p.small.text-muted.mb-0.country-aliases = "Also spelled or known as: #{country_alias_names.join(', ')}"
    = link_to "All locations", locations_path, class: "btn btn-outline-secondary btn-sm"

/ Sideways links to the rest of the region (config/regions.yml); nothing when the country is in no region.
- if (region_summary = region_summary_for_country(@country))
  - sibling_countries = region_summary.countries.reject { |c| c[:name].casecmp?(@country.to_s) }
  nav.small.mb-3.country-region-links aria-label="More in #{region_summary.name}"
    strong.me-1 = "More in #{region_summary.name}:"
    - sibling_countries.first(12).each do |c|
      = link_to c[:name], by_country_episodes_path(country: c[:name]), class: "me-2 text-nowrap"
    = link_to "All of #{region_summary.name} →", by_region_episodes_path(region: region_summary.slug), class: "text-nowrap fw-semibold"

- if @page_number == 1 && (country_desc = country_description(@country))
  .card.shadow-sm.mb-4.country-description-card
    .card-body
      h2.h6.mb-2.text-uppercase.text-muted.fw-semibold(style="letter-spacing: .5px;")
        | Survival conditions in #{@country}
      p.mb-0 = country_desc

- if @page_number == 1 && Location.where("TRIM(LOWER(country)) = ?", @country.to_s.strip.downcase).where.not(latitude: nil).where.not(longitude: nil).exists?
  - content_for :needs_map, "1"
  .card.shadow-sm.mb-4
    .card-header.d-flex.align-items-center
      span.me-2(aria-hidden="true") 🗺️
      span Map
    .card-body.p-0
      #locations-map.map-frame.map-frame-sm data-locations-url=(locations_path(format: :json, country: @country))

/ ===== Shop the gear used here =====
- if @page_number == 1 && @shop_shelf && !@shop_shelf.empty?
  = render "shop/shelf", shelf: @shop_shelf, links: @shop_links, heading: "Shop the Gear Used in #{@country}", item_params: { country: @country }

/ Cards ("blocks") are built and paginated in EpisodesController#by_country: a continuous-story
/ season (2+ eps filmed here) is one card with shared cast, any other episode its own card,
/ newest first.
- if @blocks.empty?
  .card.shadow-sm
    .card-body.text-center.text-muted.py-4 No episodes found in this country.
- else
  - @blocks.each do |b|
    - if b[:kind] == :season
      - season = b[:season]
      - eps    = b[:eps]
      - cast   = eps.flat_map(&:survivors).uniq.sort_by { |s| s.full_name.to_s.downcase }
      .card.shadow-sm.mb-4
        .card-header.d-flex.flex-wrap.align-items-center.justify-content-between.gap-2
          .d-flex.flex-column
            span.fw-semibold = "#{season.series&.name} — Season #{season.number}"
            span.small.opacity-75 = "#{eps.size} #{'episode'.pluralize(eps.size)} in #{@country}"
          span.badge.text-bg-warning Continuous Story
        - if cast.any?
          .card-body.border-bottom.py-3
            .small.text-muted.text-uppercase.fw-semibold.mb-2(style="letter-spacing: .5px;") = "Cast (#{cast.size})"
            = survivor_chips(cast, size: 40)
        .table-responsive.table-stack-host
          table.table.table-stack.table-striped.table-hover.mb-0
            thead.table-light
              tr
                th(scope="col") Episode
                th(scope="col") Air Date
                th(scope="col") Location
            tbody
              - eps.each do |ep|
                tr
                  td data-label="Episode" = link_to "#{ep.title.presence || "Episode"} ##{ep.number_in_season || ep.id}", episode_path(ep)
                  td data-label="Air Date" = ep.air_date ? ep.air_date.strftime("%b %-d, %Y") : "—"
                  td data-label="Location" = [ep.location&.country, ep.location&.region, ep.location&.site].compact_blank.join(", ").presence || "—"

    - else
      - ep = b[:ep]
      .card.shadow-sm.mb-4
        .card-header.d-flex.flex-wrap.align-items-center.justify-content-between.gap-2
          .d-flex.flex-column
            = link_to "#{ep.title.presence || 'Episode'} ##{ep.number_in_season || ep.id}", episode_path(ep), class: "fw-semibold text-decoration-none link-light"
            span.small.opacity-75 = "#{ep.season&.series&.name} — Season #{ep.season&.number}"
          span.small.opacity-75 = ep.air_date ? ep.air_date.strftime("%b %-d, %Y") : ""
        .card-body
          - loc = [ep.location&.country, ep.location&.region, ep.location&.site].compact_blank.join(", ").presence
          - if loc && loc != @country
            p.small.text-muted.mb-2 = loc
          - if ep.survivors.any?
            = survivor_chips(ep.survivors, size: 40)
          - else
            span.text-muted —

  = paginate @blocks, window: 2
