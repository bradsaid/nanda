/ ===== SEO + JSON-LD: Episodes Index =====
- if @location
  - loc_parts = [@location.site, @location.region, @location.country].compact_blank
  - loc_name  = loc_parts.join(", ").presence || "Unknown Location"
  - ep_list   = (@episodes || [])

  - content_for :title, "Naked and Afraid Episodes in #{loc_name}"
  - content_for :meta_description, "Guide to #{ep_list.size} episode(s) filmed in #{loc_name}: air dates, survivors, and details."
  - content_for :keywords, "Naked and Afraid episodes, #{loc_name}, locations, survivors, episode guide"
  - content_for :canonical_url, canonical_request_url
  - content_for :og_title, "Episodes in #{loc_name} – Naked and Afraid"
  - content_for :og_description, "All episodes filmed in #{loc_name} with dates, survivors, and details."

- elsif defined?(@season) && @season.present?
  - series_name = @season.series&.name || "Naked and Afraid"
  - title_txt   = "#{series_name} – Season #{@season.number}"
  - ep_list     = (@episodes || [])

  - content_for :title, "#{title_txt} (Episode Guide)"
  - content_for :meta_description, "#{title_txt}: #{ep_list.size} episode(s) with air dates, locations, survivors, and items."
  - content_for :keywords, "Naked and Afraid, #{series_name}, Season #{@season.number}, episodes, survivors, items"
  - content_for :canonical_url, canonical_request_url
  - content_for :og_title, "#{title_txt} – Episodes"
  - content_for :og_description, "Full episode list for #{title_txt}."

- else
  - ep_counts   = (@episode_counts || {})
  - total_count = ep_counts.values.map(&:to_i).sum

  - content_for :title, "Naked and Afraid Episodes – By Season"
  - content_for :meta_description, "Complete episode guide organized by season with air dates, locations, survivors, and items."
  - content_for :keywords, "Naked and Afraid episodes, episode guide, seasons, survivors, locations, items"
  - content_for :canonical_url, canonical_request_url
  - content_for :og_title, "Naked and Afraid Episodes – Guide by Season"
  - content_for :og_description, "Browse seasons to see episodes with dates, locations, and survivors."

/ Server-rendered JSON-LD (ItemList of episodes)
= render_jsonld(episodes_index_jsonld(episodes: @episodes, season: (defined?(@season) && @season.present?) ? @season : nil, location: @location, episodes_by_season: @episodes_by_season, episode_counts: @episode_counts))

- if @location
  / === Filtered by location ===
  - hero_flag    = country_flag_url(@location.country, size: 320)
  - hero_outline = country_outline_url(@location.country, width: 480)
  .pb-2.mb-3.border-bottom.site-header
    .d-flex.align-items-center.justify-content-between.flex-wrap.gap-3
      .d-flex.align-items-center.gap-3
        - if hero_flag && hero_outline
          .country-shape-wrap
            .country-shape.country-shape-lg(style="background-image: url(#{hero_flag}); --outline-url: url(#{hero_outline});" aria-label="#{@location.country} flag in country outline")
        - elsif hero_flag
          = image_tag hero_flag, alt: "#{@location.country} flag", width: 96, class: "rounded shadow-sm"
        .d-flex.flex-column
          h1.h3.mb-0.logo Episodes at this location
          p.subtitle.mb-0 = [@location.site, @location.region, @location.country].compact_blank.join(", ")
      = link_to "All locations", locations_path, class: "btn btn-outline-secondary btn-sm"

  - if @location.latitude.present? && @location.longitude.present?
    - content_for :needs_map, "1"
    .card.shadow-sm.mb-3
      .card-header.d-flex.align-items-center
        span.me-2(aria-hidden="true") 🗺️
        span Map
      .card-body.p-0
        #locations-map.map-frame.map-frame-sm data-locations-url=(locations_path(format: :json, location_id: @location.id)) data-no-links="true"

  - if @shop_shelf && !@shop_shelf.empty?
    = render "shop/shelf", shelf: @shop_shelf, links: @shop_links, heading: "Shop the Gear Used at This Location"

  .card.shadow-sm
    .card-header Episodes
    .table-responsive
      table.table.table-striped.table-hover.mb-0
        thead.table-light
          tr
            th(scope="col") Episode
            th(scope="col") Season
            th(scope="col") Air Date
            th(scope="col") Location
            th(scope="col") Survivors
        tbody
          - if @episodes.blank?
            tr
              td(colspan="5" class="text-muted text-center py-4") No episodes found for this location.
          - else
            / A continuous-story season is one challenge, so when it has 2+
            / episodes here it collapses into a single expandable row (placed
            / where its newest episode would have been). Everything else is
            / listed one episode per row.
            - all_eps    = @episodes.to_a
            - season_eps = all_eps.group_by(&:season_id)
            - emitted    = {}
            - rows       = []
            - all_eps.each do |ep|
              - season = ep.season
              - group  = season&.continuous_story_effective? ? season_eps[ep.season_id] : nil
              - if group && group.size >= 2
                - unless emitted[ep.season_id]
                  - emitted[ep.season_id] = true
                  - rows << { kind: :season, season: season, eps: group.sort_by { |e| [e.air_date || Date.new(1, 1, 1), e.number_in_season.to_i] } }
              - else
                - rows << { kind: :ep, ep: ep }

            - rows.each do |row|
              - if row[:kind] == :season
                - season = row[:season]
                - eps    = row[:eps]
                - cast   = eps.flat_map(&:survivors).uniq.sort_by { |s| s.full_name.to_s.downcase }
                - dates  = eps.map(&:air_date).compact
                tr.continuous-season-row
                  td(style="vertical-align: top;")
                    details
                      summary.fw-semibold(style="cursor: pointer;")
                        = "#{season.series&.name} Season #{season.number}: #{eps.size} episodes "
                        span.badge.text-bg-warning.ms-1 Continuous Story
                      ul.list-unstyled.mb-0.mt-2.ps-3
                        - eps.each do |e|
                          li.mb-1
                            = link_to "#{e.title.presence || "Episode"} ##{e.number_in_season || e.id}", episode_path(e)
                            span.text-muted.small.ms-2 = e.air_date ? e.air_date.strftime("%b %-d, %Y") : ""
                  td(style="vertical-align: top;") = "S#{season.number} • #{season.series&.name}"
                  td(style="vertical-align: top;")
                    - if dates.empty?
                      | —
                    - elsif dates.min == dates.max
                      = dates.min.strftime("%b %-d, %Y")
                    - else
                      = "#{dates.min.strftime('%b %-d, %Y')} – #{dates.max.strftime('%b %-d, %Y')}"
                  td(style="vertical-align: top;") = [eps.first.location&.country, eps.first.location&.region, eps.first.location&.site].compact_blank.join(", ").presence || "—"
                  td(style="vertical-align: top;")
                    = survivor_chips(cast, size: 40)
              - else
                - ep = row[:ep]
                tr
                  td = link_to "#{ep.title.presence || "Episode"} ##{ep.number_in_season || ep.id}", episode_path(ep)
                  td = "S#{ep.season&.number} • #{ep.season&.series&.name}"
                  td = ep.air_date ? ep.air_date.strftime("%b %-d, %Y") : "—"
                  td = [ep.location&.country, ep.location&.region, ep.location&.site].compact_blank.join(", ").presence || "—"
                  td
                    = survivor_chips(ep.survivors, size: 40)

- elsif defined?(@season) && @season.present?
  / === Filtered by season ===
  - is_continuous = @season.continuous_story_effective?
  - season_cast = is_continuous ? @episodes.flat_map(&:survivors).uniq.sort_by(&:full_name) : []
  .pb-2.mb-3.border-bottom.site-header
    .d-flex.align-items-center.justify-content-between.flex-wrap.gap-2
      h1.h3.mb-0.logo = "Season #{@season.number} • #{@season.series.name}"
      = link_to "All seasons", episodes_path, class: "btn btn-outline-secondary btn-sm"
    p.subtitle.mb-0 = "All #{@episodes.size} episode(s) in this season"

  - if is_continuous && season_cast.any?
    .card.shadow-sm.mb-3
      .card-header.d-flex.align-items-center.gap-2
        span Cast
        span.small.opacity-75 = "(#{season_cast.size})"
      .card-body
        = survivor_chips(season_cast, size: 40)

  .card.shadow-sm
    .table-responsive
      table.table.table-striped.table-hover.mb-0
        thead.table-light
          tr
            th(scope="col") Episode
            th(scope="col") Air Date
            th(scope="col") Location
            - unless is_continuous
              th(scope="col") Survivors
        tbody
          - if @episodes.blank?
            tr
              td(colspan="#{is_continuous ? 3 : 4}" class="text-muted text-center py-4") No episodes found for this season.
          - else
            - @episodes.each do |ep|
              tr
                td = link_to "#{ep.title.presence || "Episode"} ##{ep.number_in_season || ep.id}", episode_path(ep)
                td = ep.air_date ? ep.air_date.strftime("%b %-d, %Y") : "—"
                td = [ep.location&.country, ep.location&.region, ep.location&.site].compact_blank.join(", ").presence || "—"
                - unless is_continuous
                  td
                    = survivor_chips(ep.survivors, size: 40)

- else
  / === Overview (cards per season, with 'View all' link) ===
  .pb-2.mb-3.border-bottom.site-header.position-relative
    = link_to "All locations", locations_path, class: "btn btn-outline-secondary btn-sm position-absolute top-0 end-0 mt-2 me-2"
    h1.h3.mb-0.logo.text-center Naked & Afraid — Fan Database - Episodes
    / Count one challenge per episode for standard seasons, but only one per
    / (season, location) for continuous-story seasons / series.
    - episode_total = Episode.count
    - season_total  = Season.count
    - non_cont_chal = Episode.joins(season: :series).where("COALESCE(seasons.continuous_story, false) = false AND COALESCE(series.continuous_story, false) = false").count
    - cont_chal     = Episode.joins(season: :series).where("COALESCE(seasons.continuous_story, false) = true OR COALESCE(series.continuous_story, false) = true").distinct.pluck(:season_id, :location_id).size
    - challenge_total = non_cont_chal + cont_chal
    .text-center.mt-3
      p.subtitle.mb-0.mx-auto(style="max-width: 760px;")
        = "Our database tracks #{episode_total} episodes across #{season_total} seasons, covering #{challenge_total} #{'challenge'.pluralize(challenge_total)} in total. "
        | Browse every episode across the Naked and Afraid franchise, including Solo, XL, Alone, Savage, Castaways, Last One Standing, and Apocalypse, grouped by season. Click any episode for the full breakdown: air date, location, survivors, items brought and given, and more.
      p.subtitle.mb-0.mx-auto.mt-2(style="max-width: 760px;")
        | Note: the first three seasons (2013 to 2014) did not include a producer-given item. The show began providing a complimentary "given" item mid-Season 4 in 2015, and it has been a regular feature of every team challenge since.

  / === Season jump + sort controls (Stimulus-based) ===
  .d-flex.flex-wrap.gap-3.align-items-start
    / Jump to a season
    .form-floating.mb-3(style="max-width: 360px;" data-controller="season-jump")
      select.form-select#season-jump data-season-jump-target="select" data-action="change->season-jump#jump"
        option value=""
        - @seasons.each do |s|
          option value="season-#{s.id}" = "#{s.series.name} • S#{s.number}"
      label for="season-jump" Jump to a season

    / Sort seasons box (CSP-safe Stimulus)
    .form-floating.mb-3(style="max-width: 260px;"
                        data-controller="season-sort"
                        data-season-sort-base-url-value=episodes_path
                        data-season-sort-current-value=@sort)
      select.form-select id="season-sort" data-action="change->season-sort#change"
        option value="" Sort by Airdate
        option value="airdate" Sort by Oldest Airdate
        option value="newest" Sort by Newest Airdate
      label for="season-sort" Sort seasons

  - @seasons.each do |season|
    .card.shadow-sm.mb-3(id="season-#{season.id}")
      .card-header
        .d-flex.align-items-center.justify-content-between
          .fw-semibold = "#{season.series.name} — Season #{season.number}"
          - if season.continuous_story_effective?
            .badge.text-bg-warning.ms-2 Continuous Story
        / debug line to verify sort result (use raw attribute from SELECT)
        - fad = season['first_air_date'] || (season.respond_to?(:first_air_date) ? season.first_air_date : nil)
        - if fad.present?
          .small.mt-1.text-white-50.text-transform-none = "First airdate: #{fad.to_date.strftime('%b %-d, %Y')}"
        - if @all_episodes_by_season
          - synopsis = season_synopsis(season, episodes: @all_episodes_by_season[season.id] || [], survivor_count: (@survivor_counts_by_season || {})[season.id].to_i)
          - if synopsis.present?
            .small.mt-1.season-synopsis = synopsis

      - season_is_continuous = season.respond_to?(:continuous_story_effective?) && season.continuous_story_effective?
      - if season_is_continuous && (cast = @season_cast_by_id&.[](season.id)).present?
        .card-body.border-bottom.py-3
          .small.text-muted.text-uppercase.fw-semibold.mb-2(style="letter-spacing: .5px;") = "Cast (#{cast.size})"
          = survivor_chips(cast, size: 40)

      - if @episodes_by_season[season].present?
        .list-group.list-group-flush
          - @episodes_by_season[season].each do |ep|
            .list-group-item
              .d-flex.justify-content-between.align-items-start
                .me-3
                  = link_to "#{ep.title.presence || 'Episode'} ##{ep.number_in_season || ep.id}", episode_path(ep), class: "fw-semibold"
                  .small.text-muted = ep.air_date ? ep.air_date.strftime("%b %-d, %Y") : "—"
                  .small.text-muted = [ep.location&.country, ep.location&.region, ep.location&.site].compact_blank.join(", ").presence || "—"
                - unless season_is_continuous
                  .text-end.small.text-muted
                    = survivor_chips(ep.survivors, size: 40)
        - count = @episode_counts[season.id].to_i
        - if count > 3
          .px-3.pb-3
            = link_to "View all #{count} episodes",
                      episodes_path(season_id: season.id),
                      class: "btn btn-outline-primary btn-sm"
      - else
        .card-body
          .text-muted.py-4.px-3 No episodes yet in this season.

style
  | [id^="season-"] { scroll-margin-top: 80px; }
