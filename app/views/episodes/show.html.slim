
/ ===== SEO + JSON-LD: Episode Show =====
- series      = @episode.season&.series
- season      = @episode.season
- season_num  = season&.number
- ep_num      = @episode.number_in_season
- title_text  = @episode.title.presence || "Episode"
- subtitle    = episode_subtitle_parts(@episode).join(" · ")
- heading_phrase = episode_page_heading_phrase(@episode)
- air_date    = @episode.air_date&.strftime("%b %-d, %Y")
- loc         = @episode.location
- loc_str     = [loc&.country, loc&.region, loc&.site].compact_blank.join(", ").presence
/ Series, season, episode number, air date, location and the start of the synopsis (when there is
/ one) in the description; title and H1 name the series + "Season N Episode M" so the page matches
/ searches in the "Season 11 Episode 4" and "(Season 1, Episode 8)" formats.
- synopsis_plain = @episode.synopsis_text
- meta_desc = episode_page_description(@episode)
/ og:image: first survivor avatar on this episode (permanent proxy URL); with no avatar the
/ layout falls back to the site's default share image.
- og_survivor = (@episode.appearances.map(&:survivor).find { |s| s&.avatar&.attached? } rescue nil)

/ Titles & meta
- content_for :title, episode_page_title(@episode)
- content_for :meta_description, meta_desc
- content_for :keywords, "Naked and Afraid episode, #{series&.name}, Season #{season_num}, Episode #{ep_num}, #{title_text}, survivors, PSR, items"
- content_for :canonical_url, canonical_request_url
- content_for :og_title, "#{heading_phrase}: #{title_text}"
- og_facts = [("Aired #{air_date}" if air_date), loc_str].compact.join(" • ")
- content_for :og_description, synopsis_plain.present? ? synopsis_plain.first(200) : "#{og_facts}#{'. ' if og_facts.present?}Participants, PSR, results, items."
- set_share_image(avatar_share_image(og_survivor))

/ Server-rendered JSON-LD (TVEpisode)
= render_jsonld(episode_show_jsonld(@episode, appearances: @active_appearances))
/ ===== end SEO + JSON-LD =====

/ ===== Episode Show =====
- country     = loc&.country.to_s.presence
- region      = loc&.region.to_s.presence
- site        = loc&.site.to_s.presence

.container.my-4
  / ===== Back link + Title =====
  .pb-2.mb-3.border-bottom.site-header
    .d-flex.align-items-center.justify-content-between.flex-wrap.gap-2
      .d-flex.flex-column
        = link_to "← All episodes", episodes_path, class: "small link-primary text-decoration-underline"
        h1.h3.mb-1 = title_text
        - if subtitle.present?
          p.text-muted.mb-0
            - if season
              = link_to episode_subtitle_parts(@episode).first(2).join(" · "), season_path(season), class: "text-muted text-decoration-underline"
              - rest = episode_subtitle_parts(@episode).drop(2)
              - if rest.any?
                = " · #{rest.join(' · ')}"
            - else
              = subtitle
      .d-flex.flex-wrap.gap-2
        - if @shop_shelf && !@shop_shelf.empty?
          - gear_n = @shop_shelf.products.size
          = link_to "🛒 #{gear_n} #{'product'.pluralize(gear_n)} from this episode", "#episode-shop", class: "btn btn-warning btn-sm"
        - if season
          = link_to "View Season #{season.number}", season_path(season), class: "btn btn-outline-secondary btn-sm"


  / ===== Episode meta =====
  / Only the facts we have: a card is left out when its value is unknown.
  - meta_cards = []
  - meta_cards << :location if country || region || site
  - meta_cards << :air_date if air_date.present?
  - meta_cards << :days if @episode.scheduled_days.present?
  - if meta_cards.any?
    .row.g-3.mb-4
      - if meta_cards.include?(:location)
        .col-md-4
          .card.shadow-sm.h-100
            .card-body
              .d-flex.align-items-center.gap-3
                - flag = country_flag_url(country, size: 80)
                - outline = country_outline_url(country, width: 160)
                - if flag
                  = image_tag flag, alt: country_flag_alt(country), width: 40, height: 30, class: "shadow-sm rounded", style: "object-fit: cover; flex-shrink: 0;"
                - else
                  span.fs-3(aria-hidden="true") 📍
                .flex-grow-1
                  .text-uppercase.small.text-muted Location
                  .fw-semibold
                    - parts = []
                    - parts << link_to(country, by_country_episodes_path(country)) if country
                    - parts << region if region
                    - parts << site if site
                    = safe_join(parts, " • ")
                - if outline
                  = image_tag outline, alt: "#{country} outline", class: "flex-shrink-0", style: "max-height: 50px; max-width: 60px; object-fit: contain;"
      - if meta_cards.include?(:air_date)
        .col-md-4
          .card.shadow-sm.h-100
            .card-body
              .d-flex.align-items-center.gap-3
                span.fs-3(aria-hidden="true") 📅
                .flex-grow-1
                  .text-uppercase.small.text-muted Air Date
                  .fw-semibold = air_date
      - if meta_cards.include?(:days)
        .col-md-4
          .card.shadow-sm.h-100
            .card-body
              .d-flex.align-items-center.gap-3
                span.fs-3(aria-hidden="true") ⏱️
                .flex-grow-1
                  .text-uppercase.small.text-muted Scheduled Days
                  .fw-semibold = @episode.scheduled_days

  / ===== Where to Watch =====
  - watch_services = series && season ? services_for(series.name, season.number) : {}
  - if watch_services.any?
    .card.shadow-sm.mb-4
      .card-header.d-flex.align-items-center
        span.me-3.fs-3(aria-hidden="true") 📺
        h2.h5.mb-0 Where to Watch
      .card-body
        .d-flex.flex-wrap.gap-2
          - watch_services.each do |service_key, url|
            = link_to url, target: "_blank", rel: "noopener", class: "btn btn-primary btn-sm" do
              = streaming_label(service_key)

  / ===== Synopsis =====
  / Written synopsis, or a clear "coming soon" note. Without one the page is thin and, while
  / ThinContent.noindex_episodes_without_synopsis? is on, noindex (see EpisodesController#show).
  - if @episode.synopsis_present?
    .card.shadow-sm.mb-4
      .card-header
        .d-flex.align-items-center
          span.me-3.fs-3(aria-hidden="true") 📝
          h2.h5.mb-0 Episode Synopsis
      .card-body
        = linkify_survivors(@episode.synopsis, @episode.survivors)
  - else
    .card.shadow-sm.mb-4.episode-synopsis-pending
      .card-header
        .d-flex.align-items-center
          span.me-3.fs-3(aria-hidden="true") 📝
          h2.h5.mb-0 Episode Synopsis
      .card-body
        p.text-muted.mb-0 Synopsis coming soon. The cast, results and gear for this episode are listed below.

  - if @episode.notes.present?
    .card.shadow-sm.mb-4
      .card-header Notes
      .card-body
        = simple_format(@episode.notes)

  / ===== Participants =====
  / Items given to the team (given_scope "team") are hoisted into a single banner
  / above the table, once, and skipped in the per-row given column. With several
  / teams (arrangement "3+3+3+3") the banner says each team got one. Given items nobody has classified yet follow the old rule: identical
  / given sets on every row mean a team item. "Each person" items stay per row.
  / Columns nobody has data for (role, PSR, days, result, weight loss, items) are left out, and
  / the whole card is left out when nobody is recorded (EpisodeTablesHelper).
  - banner      = AppearanceItem.team_given_banner(@active_appearances)
  - team_groups = banner[:groups]
  - hoisted_ids = banner[:hoisted_ids]
  - p_rows = participant_rows(@active_appearances, episode: @episode, shelf: @shop_shelf, hoisted_ids: hoisted_ids)
  - items_visible = p_rows.any? { |r| r[:brought] || r[:given] }
  - p_cols = visible_columns(p_rows, :role, :psr, :days, :result, :weight_loss)

  - if p_rows.any?
    .card.shadow-sm
      .card-header.d-flex.align-items-center
        span.me-3.fs-3(aria-hidden="true") 👥
        h2.h5.mb-0 Participants
      - if team_groups.any?
        .px-3.py-2.bg-light.border-bottom.small
          strong.me-1 = @episode.multi_team? ? "Given to each team (#{@episode.team_count}):" : "Team given:"
          - team_groups.each_with_index do |g, i|
            - if i > 0
              | ,&nbsp;
            - gname = g.appearance_item.display_name
            = "#{item_icon(g.appearance_item.item)} #{gname}#{g.quantity > 1 ? "×#{g.quantity}" : ""}"
            - unless g.everyone
              span.text-muted.ms-1 = "(#{g.recipients.to_sentence})"
      .table-responsive.table-stack-host
        table.table.table-stack.table-striped.table-hover.mb-0
          thead.table-light
            tr
              th(scope="col") Name
              - if p_cols.include?(:role)
                th(scope="col") Role
              - if p_cols.include?(:psr)
                th(scope="col" class="text-nowrap") PSR
              - if p_cols.include?(:days)
                th(scope="col" class="text-end") Days
              - if p_cols.include?(:result)
                th(scope="col") Result
              - if p_cols.include?(:weight_loss)
                th(scope="col") Weight Loss
              - if items_visible
                th(scope="col") Items
          tbody
            - p_rows.each do |row|
              - s = row[:survivor]
              tr
                td data-label="Name"
                  .d-flex.align-items-center.gap-2
                    = link_to survivor_path(s), class: "flex-shrink-0" do
                      = image_tag avatar_src(s, name: s.full_name, variant: :chip), alt: s.full_name, loading: "lazy", class: "rounded-circle border", width: 40, height: 40, style: "object-fit: cover;"
                    div
                      = link_to(s.full_name, survivor_path(s), class: "link-primary fw-medium")
                      - if row[:appearance].partner_replacement
                        span.badge.text-bg-warning.ms-2 title="Partner replacement" PR
                - if p_cols.include?(:role)
                  td data-label="Role" = row[:role]
                - if p_cols.include?(:psr)
                  td data-label="PSR" = row[:psr]
                - if p_cols.include?(:days)
                  td.text-end data-label="Days" = row[:days]
                - if p_cols.include?(:result)
                  td data-label="Result"
                    - if row[:result]
                      span.badge class=(row[:result] == "success" ? "bg-success" : "bg-danger") = row[:result]
                - if p_cols.include?(:weight_loss)
                  td data-label="Weight Loss" = row[:weight_loss]
                - if items_visible
                  td data-label="Items"
                    - if row[:brought]
                      span
                        = "brought: "
                        = row[:brought]
                    - if row[:given]
                      - if row[:brought]
                        br
                      span
                        = "given: "
                        = row[:given]

  / ===== Traps =====
  - t_rows = trap_rows(@episode.episode_traps)
  - if t_rows.any?
    - t_cols = visible_columns(t_rows, :builders, :result, :caught)
    .card.shadow-sm.mt-4
      .card-header.d-flex.align-items-center
        span.me-3.fs-3(aria-hidden="true") 🪤
        h2.h5.mb-0 Traps
      .table-responsive.table-stack-host
        table.table.table-stack.table-sm.table-hover.mb-0
          thead.table-light
            tr
              th Type
              - if t_cols.include?(:builders)
                th Built By
              - if t_cols.include?(:result)
                th Result
              - if t_cols.include?(:caught)
                th Caught
          tbody
            - t_rows.each do |row|
              tr
                td.fw-semibold data-label="Type" = row[:trap].trap_type
                - if t_cols.include?(:builders)
                  td data-label="Built By"
                    - if row[:builders]
                      = safe_join(row[:builders].map { |s| link_to s.full_name, survivor_path(s) }, ", ")
                - if t_cols.include?(:result)
                  td data-label="Result"
                    - if row[:result]
                      span.badge class=(row[:result] == "Success" ? "bg-success" : "bg-danger") = row[:result]
                - if t_cols.include?(:caught)
                  td data-label="Caught" = row[:caught]

  / ===== Shelter =====
  - if @episode.episode_shelters.any?
    .card.shadow-sm.mt-4
      .card-header.d-flex.align-items-center
        span.me-3.fs-3(aria-hidden="true") 🏠
        h2.h5.mb-0 Shelter
      .card-body
        - @episode.episode_shelters.each do |shelter|
          .d-flex.gap-2.align-items-baseline
            span.fw-semibold = link_to shelter.shelter_type, shelter_path(shelter_type: shelter.shelter_type)
            - if shelter.materials.present?
              span.text-muted = "— #{shelter.materials}"
          - if shelter.notes.present?
            p.small.text-muted.mb-0 = shelter.notes

  / ===== Food Sources =====
  - if @episode.food_sources.any?
    - f_rows = food_source_rows(@episode.food_sources.order(:category, :name))
    - f_cols = visible_columns(f_rows, :method, :tools)
    .card.shadow-sm.mt-4
      .card-header.d-flex.align-items-center
        span.me-3.fs-3(aria-hidden="true") 🍖
        h2.h5.mb-0 Food Sources
      .table-responsive.table-stack-host
        table.table.table-stack.table-sm.table-hover.mb-0
          thead.table-light
            tr
              th Name
              th Category
              - if f_cols.include?(:method)
                th Method
              th Obtained By
              - if f_cols.include?(:tools)
                th Tools Used
          tbody
            - f_rows.each do |row|
              - fs = row[:food]
              tr
                td data-label="Name"
                  = link_to fs.name.titleize, food_source_path(fs.name)
                  - if fs.category_animal? && fs.quantity.nil?
                    span.badge.bg-secondary.ms-1 ×?
                  - elsif fs.quantity.to_i > 1
                    span.badge.bg-secondary.ms-1 = "×#{fs.quantity}"
                td data-label="Category"
                  - if fs.category_animal?
                    span.badge.bg-danger-subtle.text-danger-emphasis Animal
                  - else
                    span.badge.bg-success-subtle.text-success-emphasis Plant
                - if f_cols.include?(:method)
                  td data-label="Method" = row[:method]
                td data-label="Obtained By"
                  - if fs.survivors&.any?
                    = safe_join(fs.survivors.map { |s| link_to s.full_name, survivor_path(s) }, ", ")
                  - else
                    | Team
                - if f_cols.include?(:tools)
                  td data-label="Tools Used" = row[:tools]

  / ===== Medical Calls =====
  - m_rows = medical_call_rows(@episode.medical_calls)
  - if m_rows.any?
    - m_cols = visible_columns(m_rows, :reason, :notes)
    .card.shadow-sm.mt-4
      .card-header.d-flex.align-items-center
        span.me-3.fs-3(aria-hidden="true") 🩺
        h2.h5.mb-0 Medical Calls
      .table-responsive.table-stack-host
        table.table.table-stack.table-sm.table-hover.mb-0
          thead.table-light
            tr
              th Survivor
              - if m_cols.include?(:reason)
                th Reason
              th.text-center Tap Out
              - if m_cols.include?(:notes)
                th Notes
          tbody
            - m_rows.each do |row|
              tr
                td data-label="Survivor"
                  - if row[:survivor]
                    = link_to row[:survivor].full_name, survivor_path(row[:survivor])
                - if m_cols.include?(:reason)
                  td data-label="Reason" = row[:reason]
                td.text-center data-label="Tap Out"
                  - if row[:call].led_to_tapout
                    span.badge.bg-danger Yes
                  - else
                    span.text-muted No
                - if m_cols.include?(:notes)
                  td.text-muted data-label="Notes" = row[:notes]

  / ===== Bushcraft Items =====
  - b_rows = bushcraft_rows(@episode.bushcraft_items)
  - if b_rows.any?
    - b_cols = visible_columns(b_rows, :materials, :builders, :notes)
    .card.shadow-sm.mt-4
      .card-header.d-flex.align-items-center
        span.me-3.fs-3(aria-hidden="true") 🪵
        h2.h5.mb-0 Bushcraft Items
      .table-responsive.table-stack-host
        table.table.table-stack.table-sm.table-hover.mb-0
          thead.table-light
            tr
              th Item
              - if b_cols.include?(:materials)
                th Materials
              - if b_cols.include?(:builders)
                th Built By
              - if b_cols.include?(:notes)
                th Notes
          tbody
            - b_rows.each do |row|
              tr
                td.fw-semibold data-label="Item" = row[:item].item_type
                - if b_cols.include?(:materials)
                  td data-label="Materials" = row[:materials]
                - if b_cols.include?(:builders)
                  td data-label="Built By"
                    - if row[:builders]
                      = safe_join(row[:builders].map { |s| link_to s.full_name, survivor_path(s) }, ", ")
                - if b_cols.include?(:notes)
                  td.text-muted data-label="Notes" = row[:notes]

  / ===== Related episodes =====
  - if @related_episodes.present?
    section.card.shadow-sm.mt-4 aria-labelledby="related-episodes-heading"
      .card-header
        h2#related-episodes-heading.h5.mb-0 = "Related Episodes"
      .card-body
        .row.row-cols-1.row-cols-md-2.g-3
          - @related_episodes.each do |re|
            - re_loc = [re.location&.country, re.location&.region, re.location&.site].compact.join(" • ").presence
            - re_air = re.air_date&.strftime("%b %-d, %Y")
            - re_title = re.title.presence || "Untitled"
            .col
              .card.h-100.shadow-sm
                .card-body
                  .d-flex.justify-content-between.align-items-start.gap-2
                    h3.h6.mb-0.flex-grow-1 = link_to(re_title, episode_path(re), class: "link-primary text-decoration-underline")
                    - if re.season
                      span.badge.text-bg-secondary.flex-shrink-0 = "S#{re.season.number}E#{re.number_in_season || '—'}"
                  - if re_air
                    .small.text-muted.mt-1 = re_air
                  - if re_loc
                    .small.text-muted = re_loc

  / ===== FAQ (visible content backing the FAQPage schema) =====
  - ep_faq_qas = episode_faq_qas(@episode)
  - if ep_faq_qas.any?
    section.card.shadow-sm.mt-4 aria-labelledby="ep-faq-heading"
      .card-header
        h2#ep-faq-heading.h5.mb-0 = "Frequently Asked Questions"
      .card-body
        - ep_faq_qas.each_with_index do |qa, i|
          details.mb-2 open=(i == 0)
            summary.fw-semibold = qa[:q]
            p.mt-2.mb-0.text-muted = qa[:a]

  / ===== Gear used in this episode (affiliate) =====
  / Collapsed and last, below everything unique to the episode, so the repeated product cards do
  / not dominate the page. Links stay the tracked /go/ redirects with rel="sponsored nofollow".
  / The jump button in the header (#episode-shop) opens the section in current browsers.
  - if @shop_shelf && !@shop_shelf.empty?
    - gear_count = @shop_shelf.products.size
    details.mt-4.episode-gear
      summary.fw-semibold.text-muted.small.py-2 = "Gear used in this episode (#{gear_count} #{'product'.pluralize(gear_count)}, affiliate links)"
      .mt-2
        = render "shop/shelf", shelf: @shop_shelf, links: @shop_links, heading: "Shop the Gear From This Episode", dom_id: "episode-shop"

  / ===== Author byline (E-A-T) =====
  .card.shadow-sm.mt-4.small.text-muted
    .card-body.py-2
      == "Curated by <strong>Brad Said</strong> · Last updated #{@episode.updated_at.strftime('%B %-d, %Y')}."
      br
      == "Spot a mistake or have a comment? "
      = link_to "Use the contact form", contact_path
