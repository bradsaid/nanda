- content_for :title, "All series — Naked and Afraid Fan Wiki"
- content_for :meta_description, "Every series in the Naked and Afraid franchise: the original show, XL, Solo, Alone, Last One Standing, Castaways, Apocalypse, Global Showdown, Shipwrecked, and more."
- content_for :canonical_url, request.original_url

.container.my-4
  .pb-2.mb-4.border-bottom.site-header
    nav.small.mb-1
      = link_to "Home", root_path, class: "text-decoration-none text-muted"
      span.mx-1 &raquo;
      span Series
    h1.h3.mb-0.logo Series
    p.subtitle.mb-0.mt-1 Every branch of the Naked and Afraid franchise.

  .card.shadow-sm
    .list-group.list-group-flush
      - @series.each do |s|
        = link_to series_path(s), class: "list-group-item list-group-item-action" do
          .d-flex.justify-content-between.align-items-start.gap-3.flex-wrap
            .flex-grow-1
              strong = s.name
              - if (syn = series_synopsis(s))
                .small.text-muted.mt-1 = syn
            .text-end.text-muted.small.text-nowrap
              = "#{s.seasons_count} #{'season'.pluralize(s.seasons_count.to_i)}"
              br
              = "#{s.episodes_count} #{'episode'.pluralize(s.episodes_count.to_i)}"
