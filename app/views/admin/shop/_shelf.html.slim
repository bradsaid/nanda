/ Shop cards for an episode or survivor page. locals: shelf (ShopShelf), links (ShopLinks), heading
- unless shelf.empty?
  .card.shadow-sm.mb-4.shop-shelf
    .card-header.d-flex.align-items-center.justify-content-between
      h2.h5.mb-0 = heading
      small Admin preview
    - shelf.groups.each do |group|
      .px-3.pt-3.d-flex.flex-wrap.align-items-baseline.justify-content-between
        .fw-semibold.shop-shelf-item
          = link_to "#{item_icon(group.item)} #{group.item.name}", item_path(group.item), class: "text-decoration-none"
        - if group.hidden.positive?
          small.text-muted
            = "Showing #{group.entries.size} of #{group.total} · "
            = link_to "see all", item_path(group.item)
      ul.list-group.list-group-flush.mb-3
        - group.entries.each do |entry|
          = render "admin/shop/product", product: entry.product, item: group.item, link_item: false, links: links, specific_label: entry.label
