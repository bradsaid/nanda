- content_for :title, "Admin — Shop"
- content_for :robots, "noindex, nofollow"

- match_badge = { "confirmed" => ["bg-success", "Confirmed on the show"], "likely" => ["bg-primary", "Likely match"], "similar" => ["bg-secondary", "Similar"] }

.container.my-4
  = render "shared/flash"

  h1.h3.mb-2 Shop
  p.text-muted.small.mb-4(style="max-width: 760px;")
    | Real products used on the show, or the closest thing you can buy, with where each connection was found. Data lives in config/shop_products.yml (Amazon links checked live on the date in its header). Admin only for now.

  = form_with url: admin_shop_path, method: :get, local: true, class: "card shadow-sm mb-4" do
    .card-header.d-flex.align-items-center.gap-2
      span.me-2(aria-hidden="true") 🔎
      span Filter
    .card-body.pb-3
      .row.g-3
        .col-md-4
          = label_tag :q, "Search", class: "form-label"
          = text_field_tag :q, @q, placeholder: "e.g. machete, Gerber, Eva Rupert", class: "form-control"
        .col-md-3
          = label_tag :category, "Category", class: "form-label"
          = select_tag :category, options_for_select([["All categories", ""]] + @categories.map { |c| [c.titleize, c] }, @category), class: "form-select"
        .col-md-3
          = label_tag :match, "How sure are we", class: "form-label"
          = select_tag :match, options_for_select([["Any", ""]] + match_badge.map { |k, (_, label)| [label, k] }, @match), class: "form-select"
        .col-12.col-md-auto.d-flex.align-items-end.gap-3
          .form-check.mb-2
            = check_box_tag :amazon, "1", @amazon, class: "form-check-input"
            = label_tag :amazon, "On Amazon", class: "form-check-label"
          = submit_tag "Apply", class: "btn btn-dark mb-1"
          = link_to "Reset", admin_shop_path, class: "btn btn-light mb-1"

  p#shop-count.text-muted.mb-4
    = "#{@products.size} of #{@total} products"
    = " · #{@amazon_total} with an Amazon listing"

  - if @grouped.empty?
    .alert.alert-light.border No products match those filters.

  - @grouped.each do |category, products|
    .card.shadow-sm.mb-4
      .card-header
        = category.to_s.titleize
        small.ms-2 = "(#{products.size})"
      ul.list-group.list-group-flush
        - products.each do |p|
          - badge_class, badge_label = match_badge.fetch(p[:match], ["bg-light text-dark", p[:match].to_s.titleize])
          / Books, DVDs and merch were never "used on the show"; confirmed there means official or cast-made.
          - badge_label = "Official / cast-made" if ShopCatalog::NON_GEAR.include?(category) && p[:match] == "confirmed"
          - item = @items_by_name[p[:item].to_s.downcase]
          li.list-group-item.shop-product
            .d-flex.flex-wrap.justify-content-between.gap-3
              .flex-grow-1(style="min-width: 260px;")
                .fw-semibold
                  = p[:product]
                  span.badge.ms-2 class=badge_class = badge_label
                - if p[:brand].present?
                  .small.text-muted = p[:brand]
                - if p[:used_by].present?
                  .small.mt-1
                    | Used by: 
                    = p[:used_by]
                - if p[:evidence].present?
                  .small.text-muted.mt-1
                    = p[:evidence]
                    - if p[:evidence_url].present?
                      |  
                      = link_to "Source", p[:evidence_url], target: "_blank", rel: "noopener noreferrer nofollow"
                    - Array(p[:more_sources]).each_with_index do |url, i|
                      |  
                      = link_to "Source #{i + 2}", url, target: "_blank", rel: "noopener noreferrer nofollow"
                - if p[:notes].present?
                  .small.fst-italic.mt-1 = p[:notes]
                - if item
                  .small.mt-1
                    | On the show: 
                    = link_to "#{item_icon(item)} #{item.name}", item_path(item)
              .d-flex.flex-wrap.align-content-start.gap-2
                - Array(p[:buy]).each do |link|
                  - amazon = ShopCatalog.amazon?(link)
                  = link_to (amazon ? "View on Amazon" : "Buy at #{link[:store]}"),
                    ShopCatalog.buy_url(link),
                    class: "btn btn-sm #{amazon ? 'btn-warning' : 'btn-outline-secondary'}",
                    target: "_blank", rel: "sponsored noopener noreferrer nofollow"
