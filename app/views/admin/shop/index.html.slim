- content_for :title, "Admin — Shop"
- content_for :robots, "noindex, nofollow"

- match_badge = ShopCatalog::BADGES

.container.my-4
  = render "shared/flash"

  h1.h3.mb-2 Shop
  p.text-muted.small.mb-4(style="max-width: 760px;")
    | Real products used on the show, or the closest thing you can buy, with where each connection was found. Data lives in config/shop_products.yml (Amazon links checked live on the date in its header). Admin only for now.

  = form_with url: admin_shop_path, method: :get, local: true, class: "card shadow-sm mb-4" do
    .card-header.d-flex.align-items-center.gap-2
      span.me-2(aria-hidden="true") 🔎
      span Filter
    .card-body.pb-3
      .row.g-3
        .col-md-4
          = label_tag :q, "Search", class: "form-label"
          = text_field_tag :q, @q, placeholder: "e.g. machete, Gerber, Eva Rupert", class: "form-control"
        .col-md-3
          = label_tag :category, "Category", class: "form-label"
          = select_tag :category, options_for_select([["All categories", ""]] + @categories.map { |c| [c.titleize, c] }, @category), class: "form-select"
        .col-md-3
          = label_tag :match, "How sure are we", class: "form-label"
          = select_tag :match, options_for_select([["Any", ""]] + match_badge.map { |k, (_, label)| [label, k] }, @match), class: "form-select"
        .col-12.col-md-auto.d-flex.align-items-end.gap-3
          .form-check.mb-2
            = check_box_tag :amazon, "1", @amazon, class: "form-check-input"
            = label_tag :amazon, "On Amazon", class: "form-check-label"
          = submit_tag "Apply", class: "btn btn-dark mb-1"
          = link_to "Reset", admin_shop_path, class: "btn btn-light mb-1"

  p#shop-count.text-muted.mb-4
    = "#{@products.size} of #{@total} products"
    = " · #{@amazon_total} with an Amazon listing"

  - if @grouped.empty?
    .alert.alert-light.border No products match those filters.

  - @grouped.each do |category, products|
    .card.shadow-sm.mb-4
      .card-header
        = category.to_s.titleize
        small.ms-2 = "(#{products.size})"
      ul.list-group.list-group-flush
        - products.each do |p|
          = render "admin/shop/product", product: p, item: @items_by_name[p[:item].to_s.downcase], link_item: true, links: @links
